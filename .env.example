# Copy this file to .env:  cp .env.example .env
# (npm start refuses to boot without a .env file.)
#
# Commented-out lines show the default value. Never commit your real .env --
# it is git-ignored on purpose.

# --- Discord (bot account) ---
# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# The server and the voice channel the bot lives in.
# Discord -> User Settings -> Advanced -> Developer Mode, then right-click -> Copy ID
GUILD_ID=
CHANNEL_ID=

# --- OpenAI (GPT-Live realtime voice) ---
# https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=
# Only if you talk to a different endpoint (proxy, gateway):
# OPENAI_BASE_URL=

# --- Language ---
# Language of everything a human sees: console logs, spoken replies, the admin panel,
# slash command descriptions and the assistant's default instructions. Voice commands
# are matched in this language as well. Supported: en, tr.
# BOT_LANGUAGE=en

# --- Authorisation ---
# The bot owner. Their voice is processed with priority and the voice admin tools
# (ban / kick / roles / channels / permissions / settings) accept commands ONLY from them.
# Leave it empty to disable the voice admin tools entirely; there is NO default owner.
# OWNER_ID=
# Extra administrators for slash commands and the panel (comma-separated user/role ids).
# Members with the "Manage Server" permission are already allowed.
# ADMIN_USER_IDS=
# ADMIN_ROLE_IDS=
# Process only the owner's voice while they are speaking.
# OWNER_PRIORITY=1

# --- Model and voice ---
# LIVE_MODEL=gpt-live-1
# LIVE_VOICE=marin
# System instructions used when no character is selected
# LIVE_INSTRUCTIONS=
# First sentence the bot says after joining (leave empty to join silently)
# GREET_TEXT=

# Tool backend (Responses API + web_search): set a model here and ALL Discord/music/memory
# tools become available to the assistant. Leave it empty and only the built-in voice
# commands work. (DELEGATION_MODEL is accepted as the old name.)
# RESEARCH_MODEL=
# auto = use the Responses backend when RESEARCH_MODEL is set; "client" forces it off
# TOOLS_BACKEND=auto
# Reasoning effort for the backend; "off" omits the field
# LIVE_BACKEND_EFFORT=low
# LIVE_BACKEND_TIER=

# Model used for written replies (DMs and mentions); images are always handled by this one
# TEXT_MODEL=
# DeepSeek: if a key is set, written replies and client-side research go to DeepSeek instead.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- Behaviour ---
# Listen to this user only
# SOLO_USER_ID=
# Channel used when no channel name is spoken; JOIN_NOTICE is posted here
# TEXT_CHANNEL_ID=
# How many messages a single read returns, 1-10
# READ_LIMIT=5
# RESPOND_DMS=1
# RESPOND_MENTIONS=1
# Say written channel replies out loud in the voice channel as well
# VOICE_ECHO_TEXT_REPLIES=0
# Tell the assistant who is speaking (name, whether they are the owner, stored notes).
# With 0 the assistant cannot tell people apart.
# ANNOUNCE_SPEAKER=1
# LEAVE_DELAY_MS=2500
# Print transcripts to the console
# TRANSCRIPTS=1
# Close the session after this many idle minutes; 0 = never close
# IDLE_CLOSE_MINUTES=10
# DEBUG=0

# --- Cost control ---
# Daily GPT-Live budget in seconds (0 = unlimited). When it runs out the session stays
# closed until the next day; the owner gets a DM at 90%.
# DAILY_LIVE_SECONDS=0
# Rate limit for DMs the bot sends on its own
# DM_PER_MINUTE=10
# DM_PER_TARGET_PER_MINUTE=3

# --- Privacy ---
# Write voice transcripts and message text to the panel log (data/activity.jsonl)?
# 0 = only counted, never stored. Can also be changed at runtime.
# RECORD_TRANSCRIPTS=1
# Post a short notice in TEXT_CHANNEL_ID when the bot joins a voice channel
# JOIN_NOTICE=0

# --- Memory (per-person notes, data/memory.json) ---
# MEMORY=1

# --- Music (the bot plays its own audio: yt-dlp + ffmpeg; ducked while it speaks) ---
# MUSIC=1
# percent
# MUSIC_VOLUME=35
# volume while the bot is speaking
# MUSIC_DUCK_VOLUME=12
# how long after the bot stops speaking the volume returns
# MUSIC_DUCK_HOLD_MS=700
# local music folder; "play X" searches here first
# MUSIC_DIR=
# longer tracks are rejected; 0 = no limit
# MUSIC_MAX_MINUTES=20
# empty = look on PATH, then download into tools/bin automatically
# YTDLP_PATH=
# Fetching yt-dlp from GitHub and running it is a supply-chain decision. Set this to 0 to install it
# yourself instead; the bot then says so rather than downloading anything.
# YTDLP_AUTO_DOWNLOAD=1
# empty = the bundled ffmpeg-static binary
# FFMPEG_PATH=

# --- Other bots ---
# Bots this bot is allowed to send commands to; names or ids, comma-separated
# ALLOWED_BOTS=
# BOT_PREFIX=!
# BOT_COMMAND_CHANNEL=

# --- Gateway intents (auto = detect from the Developer Portal flags; force with 1/0) ---
# IMPORTANT: reading other people's message content requires MESSAGE_CONTENT in the portal.
# MESSAGE_CONTENT=auto
# GUILD_MEMBERS=auto
# PRESENCE=auto

# --- Local admin panel (loopback only): http://127.0.0.1:8787  (also /healthz and /metrics) ---
# PANEL=1
# PANEL_PORT=8787

# --- Local speech (Chatterbox): install with tools/setup-chatterbox.ps1, run tools/run-chatterbox.cmd ---
# Enable the feature; while off, switching to local voice mode does nothing
# LOCAL_TTS=0
# Start in local voice mode
# LOCAL_TTS_START=0
# LOCAL_TTS_URL=http://127.0.0.1:8020
# ~10 s reference recording for voice cloning
# LOCAL_TTS_VOICE=
# tr/en/de/fr/es/it/pt/ru, or "auto" to detect from the text
# LOCAL_TTS_LANG=en

# Let the bot start the Chatterbox server itself when it needs it (uses .venv-chatterbox)
# LOCAL_TTS_AUTOSTART=1
# empty = the python inside .venv-chatterbox
# LOCAL_TTS_PYTHON=
# multilingual/turbo/nano/english
# LOCAL_TTS_MODEL=multilingual
# tiny/base/small/medium/large-v3
# LOCAL_STT_MODEL=small

# --- Local brain: voice chat without OpenAI (ears = whisper, brain = DeepSeek/OpenAI chat, mouth = Chatterbox) ---
# Needs the Chatterbox server started with --stt (run-chatterbox.cmd does this) and a text model.
# auto = fall back to the local brain when GPT-Live hits a credit/key error and return when it
# recovers; local = always local; live = never fall back
# BRAIN_MODE=auto
# empty = LOCAL_TTS_URL
# LOCAL_STT_URL=
# empty/auto = detect the language
# LOCAL_STT_LANG=
# auto: name/single speaker/ongoing conversation/question; addressed: only when named; always
# LOCAL_BRAIN_RESPOND=auto
